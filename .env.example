DATABASE_URL="file:./dev.db"
# Chave que assina os logins. Gere uma só sua (não use este texto):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="gere-uma-chave-aleatoria"
PORT=3090
ADMIN_BOOTSTRAP_EMAIL="admin@lab.local"
ADMIN_BOOTSTRAP_PASSWORD="Admin123!"

# Cassino (PlayFivers): NÃO fica mais no .env. As credenciais do agente (URL, token, segredo,
# código do agente e IPs dos webhooks) são guardadas no banco e preenchidas no admin em
# Ajustes → Instalação. O catálogo sincroniza sem credenciais; os jogos só abrem depois de
# salvá-las lá. Eventuais linhas PLAYFIVERS_* antigas neste arquivo são ignoradas pelo servidor.